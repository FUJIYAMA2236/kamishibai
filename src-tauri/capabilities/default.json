{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "エディタの画面（main）にだけ許可する操作。発表・資料・PDF のウィンドウには何も許可しない",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-set-focus",
    "core:webview:allow-set-webview-zoom",
    "dialog:allow-message",
    "allow-fs-read",
    "allow-fs-write",
    "allow-fs-stat",
    "allow-fs-list",
    "allow-fs-mkdir",
    "allow-fs-remove-file",
    "allow-fs-remove-dir",
    "allow-fs-rename",
    "allow-pick",
    "allow-confirm-open",
    "allow-open-exported",
    "allow-reveal",
    "allow-app-info",
    "allow-open-page",
    "allow-print-pdf"
  ]
}
